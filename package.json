{
  "name": "school-survival-clock",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "한국 교사를 위한 실시간 생존 시계 · 요일별 시간표 레이더 · 방학 D-Day 배터리 대시보드",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
